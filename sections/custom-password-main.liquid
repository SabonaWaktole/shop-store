{% style %}
  .pw-main {
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#000000' }};
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px 24px;
    text-align: center;
  }

  .pw-block {
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 8px;
  }
  .pw-block:last-child {
    margin-bottom: 0;
  }

  /* Logo placeholder — shows dotted border when no image is set */
  .pw-logo-placeholder {
    width: 200px;
    height: 200px;
    border: 2px dashed #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .pw-logo-img {
    height: auto;
  }

  .pw-heading {
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 24px 0 8px 0;
    line-height: 1.3;
  }
  .pw-subheading {
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 24px 0;
    line-height: 1.4;
  }

  /* Form embed area */
  .pw-embed {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  /* App block wrapper */
  .pw-app-wrap {
    width: 100%;
    max-width: 600px;
  }

  /* Password enter link */
  .pw-enter-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 16px;
    cursor: pointer;
  }
  .pw-enter-link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 600px) {
    .pw-main {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
    .pw-heading {
      font-size: 17px;
    }
    .pw-subheading {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="pw-main">
  {% for block in section.blocks %}
    <div class="pw-block" {{ block.shopify_attributes }}>
      {% case block.type %}

        {% when '@app' %}
          <div class="pw-app-wrap">
            {% render block %}
          </div>

        {% when 'logo' %}
          {% if block.settings.image %}
            {% assign logo_w2 = block.settings.width | times: 2 %}
            <img
              src="{{ block.settings.image | image_url: width: logo_w2 }}"
              alt="{{ block.settings.image.alt | default: shop.name }}"
              class="pw-logo-img"
              style="max-width: {{ block.settings.width }}px; width: 100%;"
              loading="eager"
            >
          {% else %}
            <div class="pw-logo-placeholder" style="width: {{ block.settings.width }}px; height: {{ block.settings.width }}px;">
              Upload Logo
            </div>
          {% endif %}

        {% when 'heading' %}
          {% if block.settings.text != blank %}
            <h1 class="pw-heading">{{ block.settings.text }}</h1>
          {% endif %}

        {% when 'subheading' %}
          {% if block.settings.text != blank %}
            <p class="pw-subheading">{{ block.settings.text }}</p>
          {% endif %}

        {% when 'html_embed' %}
          {% if block.settings.html != blank %}
            <div class="pw-embed">
              {{ block.settings.html }}
            </div>
          {% endif %}

        {% when 'password_link' %}
          <a
            href="#password-form"
            class="pw-enter-link"
            style="font-size: {{ block.settings.font_size }}px; color: {{ block.settings.color }}; margin-top: {{ block.settings.margin_top }}px;"
          >
            {{ block.settings.text }}
          </a>

      {% endcase %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Custom Password Main",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "range",
          "id": "width",
          "min": 50,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Max Width",
          "default": 200
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading Text",
          "default": "YOU MISSED THE DROP!!"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subheading Text",
          "default": "SIGN UP FOR EARLY ACCESS SO THAT DOESN'T HAPPEN AGAIN"
        }
      ]
    },
    {
      "type": "html_embed",
      "name": "Custom HTML / Form Embed",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML code",
          "info": "Paste your SMS signup form or any embed code here."
        }
      ]
    },
    {
      "type": "password_link",
      "name": "Enter Using Password Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "ENTER USING PASSWORD"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "font_size",
          "min": 10,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Font Size",
          "default": 14
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Top Margin",
          "default": 20
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Password Main",
      "blocks": [
        { "type": "logo" },
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "html_embed" },
        { "type": "password_link" }
      ]
    }
  ]
}
{% endschema %}
