<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>

    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style>
      /* ── Minimalist password page reset ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
        background-color: #ffffff;
        color: #000000;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      .password-page-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 40px 20px;
      }

      /* ── Full-page password screen ── */
      .password-page {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999;
        background: #ffffff;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
        text-align: center;
      }
      .password-page.is-active {
        display: flex;
      }
      .password-page__back {
        position: absolute;
        top: 24px;
        left: 24px;
        background: none;
        border: none;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        color: #000;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .password-page__back:hover {
        opacity: 0.6;
      }
      .password-page__title {
        font-size: 20px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 32px;
      }
      .password-page__input-group {
        display: flex;
        gap: 10px;
        width: 100%;
        max-width: 420px;
      }
      .password-page__input {
        flex: 1;
        padding: 14px 18px;
        border: 1px solid #000;
        border-radius: 0;
        font-size: 14px;
        outline: none;
        font-family: inherit;
      }
      .password-page__input:focus {
        border-color: #000;
        box-shadow: 0 0 0 1px #000;
      }
      .password-page__submit {
        padding: 14px 28px;
        background: #000;
        color: #fff;
        border: none;
        border-radius: 0;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        font-family: inherit;
      }
      .password-page__submit:hover {
        background: #222;
      }
      .password-page__error {
        color: #cc0000;
        font-size: 13px;
        margin-top: 14px;
      }
      @media screen and (max-width: 500px) {
        .password-page__input-group {
          flex-direction: column;
        }
        .password-page__submit {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <main
      id="MainContent"
      class="password-page-wrapper"
      role="main"
    >
      {{ content_for_layout }}
    </main>

    {%- comment -%} Full-page password screen {%- endcomment -%}
    {%- form 'storefront_password' -%}
      <div id="password-page" class="password-page{% if form.errors %} is-active{% endif %}">
        <button type="button" id="password-back-btn" class="password-page__back" aria-label="Go back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Back
        </button>

        <h1 class="password-page__title">Enter store password</h1>

        <div class="password-page__input-group">
          <label for="Password" class="visually-hidden">Password</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="password-page__input"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="password-error"
            {%- endif -%}
            placeholder="Password"
          >
          <button class="password-page__submit" type="submit">
            Submit
          </button>
        </div>

        {%- if form.errors -%}
          <div id="password-error" class="password-page__error">
            Wrong password. Please try again.
          </div>
        {%- endif -%}
      </div>
    {%- endform -%}

    <script>
      (function() {
        var page = document.getElementById('password-page');
        var backBtn = document.getElementById('password-back-btn');

        // Back button hides the password page
        if (backBtn) {
          backBtn.addEventListener('click', function() {
            page.classList.remove('is-active');
          });
        }

        // Any link with href="#password-form" opens the password page
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a[href="#password-form"], [data-open-password]');
          if (link) {
            e.preventDefault();
            page.classList.add('is-active');
            var input = document.getElementById('Password');
            if (input) input.focus();
          }
        });
      })();
    </script>
  </body>
</html>

