<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>

    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style>
      /* ── Minimalist password page reset ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
        background-color: #ffffff;
        color: #000000;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      .password-page-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 40px 20px;
      }

      /* ── Password dialog modal styles ── */
      .password-dialog {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 40px;
        max-width: 420px;
        width: 90%;
        background: #fff;
      }
      .password-dialog::backdrop {
        background: rgba(0,0,0,0.5);
      }
      .password-dialog__header {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 16px;
      }
      .password-dialog__close-btn {
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #000;
        line-height: 1;
      }
      .password-dialog__title {
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 20px;
        text-align: center;
      }
      .password-dialog__input-group {
        display: flex;
        gap: 8px;
      }
      .password-dialog__input {
        flex: 1;
        padding: 12px 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 14px;
        outline: none;
      }
      .password-dialog__input:focus {
        border-color: #000;
      }
      .password-dialog__submit {
        padding: 12px 24px;
        background: #000;
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
      }
      .password-dialog__submit:hover {
        background: #333;
      }
      .password-dialog__error {
        color: #cc0000;
        font-size: 13px;
        margin-top: 10px;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <main
      id="MainContent"
      class="password-page-wrapper"
      role="main"
    >
      {{ content_for_layout }}
    </main>

    {%- comment -%} Password dialog modal — triggered by "Enter using password" link {%- endcomment -%}
    {%- form 'storefront_password' -%}
      <div id="password-form" style="display:none;">
        <dialog
          id="password-dialog"
          class="password-dialog"
          {% if form.errors %}open{% endif %}
          aria-labelledby="password-dialog-heading"
        >
          <div class="password-dialog__header">
            <button
              class="password-dialog__close-btn"
              type="button"
              id="close-password-dialog"
              aria-label="Close"
            >&times;</button>
          </div>
          <div>
            <h2 id="password-dialog-heading" class="password-dialog__title">
              Enter store password
            </h2>
            <div class="password-dialog__input-group">
              <label for="Password" class="visually-hidden">Password</label>
              <input
                type="password"
                name="password"
                id="Password"
                class="password-dialog__input"
                autocomplete="current-password"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordLoginForm-password-error"
                {%- endif -%}
                placeholder="Password"
                autofocus
              >
              <button class="password-dialog__submit" type="submit">
                Submit
              </button>
            </div>
            {%- if form.errors -%}
              <div id="PasswordLoginForm-password-error" class="password-dialog__error">
                Wrong password. Try again.
              </div>
            {%- endif -%}
          </div>
        </dialog>
      </div>
    {%- endform -%}

    <script>
      (function() {
        var dialog = document.getElementById('password-dialog');
        var closeBtn = document.getElementById('close-password-dialog');

        // Close button
        if (closeBtn && dialog) {
          closeBtn.addEventListener('click', function() {
            dialog.close();
          });
        }

        // Open on error
        if (dialog && dialog.hasAttribute('open')) {
          dialog.removeAttribute('open');
          if (typeof dialog.showModal === 'function') {
            dialog.showModal();
          }
        }

        // Global handler: any link pointing to #password-form opens the dialog
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a[href="#password-form"], [data-open-password]');
          if (link) {
            e.preventDefault();
            if (dialog && typeof dialog.showModal === 'function') {
              dialog.showModal();
            }
          }
        });
      })();
    </script>
  </body>
</html>
